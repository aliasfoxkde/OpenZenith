# OpenZenith API Environment Variables
# Copy this file to .env.local and fill in the values

# Storage backend: "r2" for Cloudflare R2, "local" for filesystem
STORAGE_BACKEND=r2

# DEM tiles directory (for local storage backend)
DEM_TILES=./data/srtm30m-merged

# GEBCO bathymetry tile URL pattern
GEBCO_TILE_URL=https://openzenith.pages.dev/api/gebco-tile/{z}/{x}/{y}

# OpenSky Network API credentials (https://openskynetwork.org)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FIRMS MAP API key (https://firms.modaps.eosdis.nasa.gov)
FIRMS_MAP_KEY=

# AISstream API key (https://aisstream.io)
AISSTREAM_KEY=

# Allowed CORS origins (comma-separated, no spaces)
# Use "*" for development, specific origins for production
# Example: https://openzenith.cyopsys.com,https://openzenith.pages.dev
ALLOWED_ORIGINS=*
