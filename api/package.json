{
  "name": "openzenith",
  "version": "0.9.1",
  "private": true,
  "description": "OpenZenith - Free global elevation API and tiling service",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:generate": "node scripts/gen-openapi.mjs",
    "openapi:check": "node scripts/gen-openapi.mjs --check",
    "test:coverage": "vitest run --coverage",
    "test:docs-claims": "vitest run src/lib/__tests__/docs-claims.test.ts",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "npx wrangler pages dev .vercel/output/static --compatibility-date=2025-01-01 --port 9006 --ip 0.0.0.0",
    "pages:deploy": "npx wrangler pages deploy .vercel/output/static",
    "test:e2e": "npx playwright test",
    "predev": "node scripts/copy-vendor-assets.mjs",
    "prebuild": "node scripts/copy-vendor-assets.mjs",
    "prepages:build": "node scripts/copy-vendor-assets.mjs"
  },
  "dependencies": {
    "brotli-dec-wasm": "^2.3.2",
    "fflate": "^0.8.2",
    "fzstd": "^0.1.1",
    "next": "^15.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shpjs": "^6.2.0",
    "zstd-wasm": "^0.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/next-on-pages": "^1.13.12",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.1",
    "@playwright/test": "^1.58.2",
    "@types/maplibre-gl": "^1.13.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^5.0.2",
    "cesium": "^1.119.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "satellite.js": "^5.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.137.0"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "ws": "^8.21.0"
  }
}
