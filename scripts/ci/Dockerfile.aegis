# CI image for the `aegis` delta-gate job in .gitforge.yml
# (tag: openzenith-ci-aegis:N, built by scripts/ci/build-ci-image.sh).
#
# Why a dedicated image: the GitForge runner bind-mounts ONLY the job
# workspace (at /workspace), so host-installed tooling is unreachable and
# toolchains must be baked into the image — the kubix-ci-python:1 pattern.
# The aegis binary is dynamically linked against GLIBC_2.39 (built on this
# host's Debian trixie), which rules out the pipeline's node:22-bookworm
# jobs (glibc 2.36); this image is trixie-based and is used by the aegis
# job only, leaving every other job's toolchain untouched.
#
# Rebuild after an aegis upgrade: scripts/ci/build-ci-image.sh <next-tag>,
# then bump the `image:` line on the aegis job in .gitforge.yml. Images must
# exist on the runner host before a push references them (60s acquisition
# cap rules out pulls at run time — see the .gitforge.yml header).
FROM node:22-trixie
COPY aegis /usr/local/bin/aegis
# Fail the build, not the first CI run, if the baked toolchain is broken.
RUN chmod +x /usr/local/bin/aegis \
    && aegis --help > /dev/null \
    && python3 --version \
    && bash -c 'echo bash-ok'
